# Cratos – Environment Configuration
# Copy this file to .env and uncomment what you need.
# All values shown are the defaults – only set what you want to override.

# ── Admin credentials ──────────────────────────────────────────────────────
# Created automatically on first start.
CRATOS_ADMIN_USERNAME=admin
CRATOS_ADMIN_PASSWORD=admin

# ── Service ports ──────────────────────────────────────────────────────────
# CRATOS_API_PORT=9101
# CRATOS_POSTGRES_PORT=9433
# CRATOS_REDIS_PORT=9638
# CRATOS_UI_PORT=3001

# ── Frontend ───────────────────────────────────────────────────────────────
# Must be a URL reachable by the browser (not an internal Docker hostname).
# VITE_SCHEDULER_API_URL=http://localhost:9101

# ── Django ─────────────────────────────────────────────────────────────────
# Secret key is auto-generated on each start if not set.
# Set a fixed value to keep sessions valid across restarts.
# DJANGO_SECRET_KEY=change-me-in-production
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=*

# ── Security / CORS ────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to make cross-site requests.
# CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# CORS_ALLOW_ALL=False
