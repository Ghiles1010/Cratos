# Cratos – Environment Configuration
# Create a .env file and set only what you want to override.
# All variables are optional — Cratos works out of the box with no configuration.

# ── Admin credentials ──────────────────────────────────────────────────────
# CRATOS_ADMIN_USERNAME=admin # default
# CRATOS_ADMIN_PASSWORD=admin # default

# ── Database ────────────────────────────────────────────────────────────────
# Defaults run a bundled Postgres container. To use an external database,
# set DB_HOST (and optionally the rest) and remove the cratos-postgres service.
# DB_NAME=your-database-name
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# DB_HOST=your-database-host
# DB_PORT=5432 # default

# ── Redis ───────────────────────────────────────────────────────────────────
# Defaults run a bundled Redis container. To use an external Redis instance,
# set REDIS_URL and remove the cratos-redis service.
# REDIS_URL=redis://your-redis-host:6379/0

# ── Service ports ──────────────────────────────────────────────────────────
# Host ports exposed by the bundled services.
# CRATOS_API_PORT=9101
# CRATOS_UI_PORT=3001
# CRATOS_POSTGRES_PORT=9433  # irrelevant if using an external database (DB_HOST)
# CRATOS_REDIS_PORT=9638     # irrelevant if using an external Redis (REDIS_URL)

# ── Deployment ──────────────────────────────────────────────────────────────
# Required when deploying on a remote host — must be publicly reachable.
# Defaults to localhost, which works for local setups without any configuration.
# CRATOS_API_URL=https://cratos.your-domain.com

